GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Answers below this top retrieval score return "insufficient evidence"
# without calling the LLM. Lower it if relevant questions get refused.
MIN_RETRIEVAL_SCORE=0.2

# Optional Neo4j graph store. Uncomment to enable it (see docs/neo4j-local.md);
# left commented, the app runs with SQLite + FAISS only.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-this-for-local-development
# NEO4J_DATABASE=neo4j
